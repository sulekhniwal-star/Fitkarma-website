# -----------------------------------------------------------------------------
# FitKarma Pre-Launch Platform — Environment Template
# Note: Placeholders only. Copy to .env.local for local development. Never commit real keys.
# -----------------------------------------------------------------------------

# Public Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-min-length-for-local-development

# Supabase Server-Side Secret Key (Privileged server operations only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-for-admin-and-allocation

# Transactional Email (Resend)
# In development/testing, keep EMAIL_DEV_SINK=true to log emails to stdout instead of sending.
RESEND_API_KEY=re_placeholder_api_key_resend
EMAIL_DEV_SINK=true
EMAIL_FROM="FitKarma VIP Beta <beta@fitkarma.in>"

# Admin Portal Authorization
# Comma-separated list of allowlisted admin emails permitted to access /admin
ADMIN_EMAIL_ALLOWLIST="sulekhniwal@gmail.com,admin@fitkarma.in"

# Gate & Launch Controls
# Set to true to temporarily pause new registrations (emergency brake / maintenance)
BETA_REGISTRATION_PAUSED=false

